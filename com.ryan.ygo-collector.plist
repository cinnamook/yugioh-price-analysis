<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.ryan.ygo-collector</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
    <string>/Users/ryannguyen/Downloads/TCG Market Analysis/collect_snapshot.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/ryannguyen/Downloads/TCG Market Analysis</string>
  <!-- Runs daily at 1:00pm. Asleep then? launchd runs it when the Mac next wakes. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/ryannguyen/Downloads/TCG Market Analysis/data/collector.log</string>
  <key>StandardErrorPath</key><string>/Users/ryannguyen/Downloads/TCG Market Analysis/data/collector.log</string>
</dict>
</plist>
